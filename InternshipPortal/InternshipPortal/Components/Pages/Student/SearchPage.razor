@inject NavigationManager Navigation

@rendermode InteractiveServer

@using InternshipPortal.Services;
@inherits OwningComponentBase
@inject AuthenticationStateProvider authenticationStateProvider

@using InternshipPortal.Services;
@using InternshipPortal.Models;

@inject InternshipService InternshipService
@inject InternshipDbContext DbContext

@page "/search"

@code {
	string companyInput = "";
	string locationInput = "";
	string keywordInput = "";
}

<PageTitle>Search</PageTitle>

<h3>Hello, @GetStuPrefName()!</h3>

<p>Discover internships by using the criteria below.</p>
<input type="text" class="company" placeholder="Company" name="company" @bind="companyInput">
<input type="text" class="location" placeholder="Location" name="location" @bind="locationInput"><br>
<input type="text" class="keywords" placeholder="Keywords (comma-separated)" name="keywords" @bind="keywordInput">
<button @onclick="SearchListings">Search</button>

@code {
	public string preferredName = "";
	private bool authIsCoordinator;
	private string? authName;
	private UserAuthenticationService? UserAuthenticationService { get; set; }

	public string GetStuPrefName()
	{
		var user = DbContext.UserAccounts.FirstOrDefault(u => u.Username == authName);
		var student = DbContext.Students.FirstOrDefault(s => s.StudentId == user.RoleSpecificId);
		return student?.PreferredName ?? student?.FirstName;
	}

	protected override async Task OnInitializedAsync()
	{
		UserAuthenticationService = ScopedServices.GetRequiredService<UserAuthenticationService>();
		authName = await UserAuthenticationService.GetUserName(authenticationStateProvider);

		if (!await UserAuthenticationService.IsUserInRole(authenticationStateProvider, "Coordinator"))
		{
			Navigation.NavigateTo("/");
		}

		var user = DbContext.UserAccounts.FirstOrDefault(u => u.Username == authName);
		var coord = DbContext.Students.FirstOrDefault(s => s.CoordinatorId == user.RoleSpecificId);

		preferredName = coord?.PreferredName ?? coord?.FirstName;
	}

	private class SortedListing
	{
		public InternshipListing Listing { get; set; }
		public int Fitness { get; set; }
	}

	List<SortedListing> sortedInternships = new();

	public void SearchListings()
	{
		sortedInternships.Clear();

		foreach (var internship in DbContext.InternshipListings)
		{
			int fitness = 0;

			if (companyInput != String.Empty && !internship.Company.ToLower().Contains(companyInput.ToLower()))
			{
				continue;
			}

			if (keywordInput != String.Empty) {
				string[] keywords = keywordInput.Split(',');

				for (int i = 0; i < keywords.Length; i++)
				{
					if (internship.Title.ToLower().Contains(keywords[i].ToLower()) || internship.Description.ToLower().Contains(keywords[i].ToLower()))
					{
						fitness += 10;
					}
					else if (internship.ExtendedDescription != null && internship.ExtendedDescription.ToLower().Contains(keywords[i].ToLower()))
					{
						fitness += 10;
					}
				}
			}

			if (locationInput != String.Empty)
			{
				string[] keywords = locationInput.Split(',');

				for (int i = 0; i < keywords.Length; i++)
				{
					if (internship.Location.ToLower().Contains(keywords[i].ToLower()))
					{
						fitness += 10;
					}
				}
			}

			for (int i = 0; i < sortedInternships.Count; i++)
			{
				if (fitness > sortedInternships[i].Fitness)
				{
					sortedInternships.Insert(i, new SortedListing { Listing = internship, Fitness = fitness });
					break;
				}
			}
			
			if (!sortedInternships.Any(x => x.Listing.InternshipListingId == internship.InternshipListingId)) {
				sortedInternships.Add(new SortedListing { Listing = internship, Fitness = fitness });
			}
		}
	}
}

<div class="card-list">

@foreach (var internship in sortedInternships)
{
		var currentListing = internship.Listing;
		<SimpleInternshipCard Title="@currentListing.Title"
		Site="@currentListing.Site"
		Company="@currentListing.Company"
		Location="@currentListing.Location"
		Description="@currentListing.Description"
		ListingID="@currentListing.InternshipListingId"/>
}
</div>