@using InternshipPortal.Models
@using InternshipPortal.Services;
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies

@inject InternshipService InternshipService
@inject InternshipDbContext DbContext
@inject NavigationManager Navigation

@page "/completeaccount"

@code {
	[CascadingParameter]
	public HttpContext HttpContext { get; set; }
	
	string prefNameInput;
	string passwordInput;

	protected override void OnInitialized()
	{
		UserAccount? user = DbContext.UserAccounts.FirstOrDefault(u => u.Username == HttpContext.User.Identity.Name);
		Student? student = DbContext.Students.FirstOrDefault(s => s.StudentId == user.RoleSpecificId);
		prefNameInput = student?.PreferredName ?? string.Empty;
	}
}

<PageTitle>Complete Account</PageTitle>

<h3>Welcome! Please enter your login information below.</h3>

<p>To create a new student account, please fill out the form below.</p>

<div>
	<input type="text" class="title" placeholder="Preferred Name" name="prefName" @bind="prefNameInput"><br>
	<input type="text" class="password" placeholder="New Password" name="password" @bind="passwordInput"><br>
	<form onsubmit="FinalizeAccount">
		<button type="submit">Finalize Account</button><br>
	</form>
	<p>@errorMessage</p>
</div>

@code {
	private string? errorMessage = string.Empty;

	private void FinalizeAccount()
	{
		UserAccount? user = DbContext.UserAccounts.FirstOrDefault(u => u.Username == HttpContext.User.Identity.Name);
		Student? student = DbContext.Students.FirstOrDefault(s => s.StudentId == user.RoleSpecificId);

		if (prefNameInput != null && passwordInput != null)
		{
			DbContext.UserAccounts.Remove(user);
			DbContext.UserAccounts.Add(new UserAccount
			{
				UserAccountId = user.UserAccountId,
				RoleSpecificId = user.RoleSpecificId,
				Username = HttpContext.User.Identity.Name,
				Password = passwordInput,
				Role = "Student",
				Registered = true
			});

			DbContext.Students.Remove(student);
			DbContext.Students.Add(new Student
			{
				StudentId = student.StudentId,
				PreferredName = prefNameInput,
				FirstName = student.FirstName,
				LastName = student.LastName,
				Concentration = student.Concentration,
				CoordinatorId = student.CoordinatorId,
				Email = student.Email
			});

			DbContext.SaveChanges();
		}
		else
		{
			errorMessage = "Please fill in all fields.";
		}
	}
}