@inject NavigationManager Navigation

@rendermode InteractiveServer

@using InternshipPortal.Services;
@inherits OwningComponentBase
@inject AuthenticationStateProvider authenticationStateProvider

@inject InternshipDbContext DbContext

@code {
	public string preferredName = "";
	private bool authIsCoordinator;
	private string? authName;
	private UserAuthenticationService? UserAuthenticationService { get; set; }

	public string GetCoordPrefName()
	{
		var user = DbContext.UserAccounts.FirstOrDefault(u => u.Username == authName);
		var coord = DbContext.Coordinators.FirstOrDefault(c => c.CoordinatorId == user.RoleSpecificId);
		return coord?.PreferredName ?? coord?.FirstName;
	}

	protected override async Task OnInitializedAsync()
	{
		UserAuthenticationService = ScopedServices.GetRequiredService<UserAuthenticationService>();
		authName = await UserAuthenticationService.GetUserName(authenticationStateProvider);

		if (!await UserAuthenticationService.IsUserInRole(authenticationStateProvider, "Coordinator"))
		{
			Navigation.NavigateTo("/");
		}

		var user = DbContext.UserAccounts.FirstOrDefault(u => u.Username == authName);
		var coord = DbContext.Students.FirstOrDefault(s => s.CoordinatorId== user.RoleSpecificId);

		preferredName = coord?.PreferredName ?? coord?.FirstName;
	}
}

@inject InternshipService InternshipService
@inject InternshipDbContext DbContext


@page "/coordhome"

<PageTitle>Home</PageTitle>

<h3>Hello, @GetCoordPrefName()!</h3>

<p>Discover your recommended internships below.</p>

<div title="Internship Listings Coordinator" class="card-list">
	@foreach (var internship in DbContext.InternshipListings)
	{
		<InternshipCard Title="@internship.Title"
				Site="@internship.Site"
				Company="@internship.Company"
				Location="@internship.Location"
				Description="@internship.Description"
				ListingID="@internship.InternshipListingId"
				PageId="1" />
	}
</div>