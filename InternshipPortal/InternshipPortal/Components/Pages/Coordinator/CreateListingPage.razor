@inject NavigationManager Navigation

@rendermode InteractiveServer

@using InternshipPortal.Services;
@inherits OwningComponentBase
@inject AuthenticationStateProvider authenticationStateProvider

@using InternshipPortal.Models

@inject InternshipService InternshipService
@inject InternshipDbContext DbContext

@page "/createlisting"
@code {
	string titleInput;
	string companyInput;
	string locationInput;
	string siteInput;
	string descriptionInput;
	string extendedDescriptionInput;
}

<PageTitle>Create Internship Listing</PageTitle>

<h3>Hello, @GetCoordPrefName()!</h3>

<p>To create a new internship listing, please fill out the form below.</p>

<div>
	<input type="text" class="title" placeholder="Title" name="title" @bind="titleInput"><br>
	<input type="text" class="company" placeholder="Company" name="company" @bind="companyInput">
	<input type="text" class="location" placeholder="Location" name="location" @bind="locationInput">
	<input type="text" class="site" placeholder="Site" name="site" @bind="siteInput">
	<input type="text" class="description" placeholder="Description" name="description" @bind="descriptionInput">
	<textarea class="extended_desc" placeholder="Extended Description" name="extendedDescription" @bind="extendedDescriptionInput"/><br>
	<button type="submit" @onclick="CreateListing">Create Listing</button>
</div>

@code {
	public string preferredName = "";
	private bool authIsCoordinator;
	private string? authName;
	private UserAuthenticationService? UserAuthenticationService { get; set; }

	public string GetCoordPrefName()
	{
		var user = DbContext.UserAccounts.FirstOrDefault(u => u.Username == authName);
		var coord = DbContext.Coordinators.FirstOrDefault(c => c.CoordinatorId == user.RoleSpecificId);
		return coord?.PreferredName ?? coord?.FirstName;
	}

	protected override async Task OnInitializedAsync()
	{
		UserAuthenticationService = ScopedServices.GetRequiredService<UserAuthenticationService>();
		authName = await UserAuthenticationService.GetUserName(authenticationStateProvider);

		if (!await UserAuthenticationService.IsUserInRole(authenticationStateProvider, "Coordinator"))
		{
			Navigation.NavigateTo("/");
		}

		var user = DbContext.UserAccounts.FirstOrDefault(u => u.Username == authName);
		var coord = DbContext.Students.FirstOrDefault(s => s.CoordinatorId == user.RoleSpecificId);

		preferredName = coord?.PreferredName ?? coord?.FirstName;
	}

	private void CreateListing()
	{
		InternshipListing newListing = new InternshipListing
		{
			Title = titleInput,
			Company = companyInput,
			Location = locationInput,
			Site = siteInput,
			Description = descriptionInput,
			ExtendedDescription = extendedDescriptionInput
		};
		DbContext.InternshipListings.Add(newListing);

		titleInput = string.Empty;
		companyInput = string.Empty;
		locationInput = string.Empty;
		siteInput = string.Empty;
		descriptionInput = string.Empty;
		extendedDescriptionInput = string.Empty;

		DbContext.SaveChanges();

		Navigation.NavigateTo($"/internshipinfo/{newListing.InternshipListingId}");
	}
}