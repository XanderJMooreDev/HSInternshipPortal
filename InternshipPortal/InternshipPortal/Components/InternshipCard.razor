@inject NavigationManager Navigation

@rendermode InteractiveServer

@using InternshipPortal.Services;
@inherits OwningComponentBase
@inject AuthenticationStateProvider authenticationStateProvider

@code {
	private bool authIsCoordinator;
	private UserAuthenticationService? UserAuthenticationService { get; set; }
}

<div class="card">
	<p class="title">@Title</p>
	<p class="subtext">@Company • @Location</p>
	<p class="subtext">@Applicants students applied</p>
	<p class="subtext">@Description</p>
	<a class="subtext" href="https://www.@Site">@Site</a>

	<button @onclick="ViewPage">View Page</button>

	@if (authIsCoordinator)
	{
		<button @onclick="EditListing">Edit Listing</button>
	}
</div>

@code {
	[Parameter]
	public string Title { get; set; } = "";
	[Parameter]
	public string Site { get; set; } = "";
	[Parameter]
	public string Company { get; set; } = "";
	[Parameter]
	public string Location { get; set; } = "";
	[Parameter]
	public string Description { get; set; } = "";
	[Parameter]
	public int ListingId { get; set; } = 0;
	[Parameter]
	public int Applicants { get; set; } = 0;
	[Parameter]
	public int PageId { get; set; } = 0;

	protected override async Task OnInitializedAsync()
	{
		UserAuthenticationService = ScopedServices.GetRequiredService<UserAuthenticationService>();
		authIsCoordinator = await UserAuthenticationService.IsUserInRole(authenticationStateProvider, "Coordinator");
	}

	private void ViewPage()
	{
		Navigation.NavigateTo($"/internshipinfo/{ListingId}");
	}

	private void EditListing()
	{
		Navigation.NavigateTo($"/editlisting/{ListingId}");
	}
}
