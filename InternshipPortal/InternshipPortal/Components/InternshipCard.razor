@inject NavigationManager Navigation

@code {
	[CascadingParameter]
	public HttpContext HttpContext { get; set; }
}

<div class="card">
	<p class="title">@Title</p>
	<p class="subtext">@Company • @Location</p>
	<p class="subtext">@Applicants students applied</p>
	<p class="subtext">@Description</p>
	<a class="subtext" href="https://www.@Site">@Site</a>
	
	<form method="post" @onsubmit="@ViewPage" @formname="@GetViewFormName">
		<button type="submit">View Page</button>
		<AntiforgeryToken />
	</form>

	@if (HttpContext.User.IsInRole("Coordinator"))
	{
		<form method="post" @onsubmit="@EditListing" @formname="@GetEditFormName">
			<button type="submit">Edit Listing</button>
			<AntiforgeryToken />
		</form>
	}
</div>

@code {
	[Parameter]
	public string Title { get; set; } = "";
	[Parameter]
	public string Site { get; set; } = "";
	[Parameter]
	public string Company { get; set; } = "";
	[Parameter]
	public string Location { get; set; } = "";
	[Parameter]
	public string Description { get; set; } = "";
	[Parameter]
	public int ListingId { get; set; } = 0;
	[Parameter]
	public int Applicants { get; set; } = 0;
	[Parameter]
	public int PageId { get; set; } = 0;

	private void ViewPage()
	{
		Navigation.NavigateTo($"/internshipinfo/{ListingId}");
	}

	private void EditListing()
	{
		Navigation.NavigateTo($"/editlisting/{ListingId}");
	}

	private string GetViewFormName => $"ViewPageForm_{ListingId}";

	private string GetEditFormName => $"EditPageForm_{ListingId}_{PageId}";
}
